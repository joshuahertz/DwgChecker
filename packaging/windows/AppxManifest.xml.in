<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest. CMake fills in the version (build/msix/AppxManifest.xml);
  packaging/windows/make_msix.ps1 packs it with the installed files (DECISIONS D64).

  Identity and PublisherDisplayName are the values Partner Center gives the app (Product
  identity page) and must match them exactly. The Store signs the package after upload.

  Only runFullTrust (a desktop app). Windows keeps the app's AppData and registry writes in
  its package, as for any Store desktop app: the copies opened in AutoCAD go to Documents,
  which AutoCAD can see, and the app never starts AutoCAD (D96).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="13710gruepr.DWGChecker"
            Publisher="CN=06F1A065-BAE3-4E3B-878B-6C4471EB60C4"
            Version="@DWGCHECK_MSIX_VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DWG Checker</DisplayName>
    <PublisherDisplayName>gruepr</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DwgChecker" Executable="DwgChecker.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DWG Checker"
                          Description="Grades CAD drawings (DWG) against reference solutions"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
